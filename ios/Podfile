# 1. Set the global platform to iOS 15.4 (aligned with Xcode/Swift requirements)
platform :ios, '15.4'

# Optimizations
install! 'cocoapods', :disable_input_output_paths => true
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Run flutter pub get first."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # 1. Apply config to PODS project targets
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Force stable deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.4'

      # Fix legacy flag interference
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'NO'

      # Enable compatibility for modern architectures (Bitcode deprecation)
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Fix "Include of non-modular header inside framework module" (Xcode 16)
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      
      # Explicitly suppress non-modular include errors
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_name|
        flags = config.build_settings[flag_name] || ['$(inherited)']
        new_flag = '-Wno-non-modular-include-in-framework-module'
        if flags.is_a?(Array)
          flags << new_flag unless flags.include?(new_flag)
        elsif flags.is_a?(String)
          flags += " #{new_flag}" unless flags.include?(new_flag)
        end
        config.build_settings[flag_name] = flags
      end

      # Enforce Swift 5.0 to avoid Swift 6 concurrency/strictness errors
      config.build_settings['SWIFT_VERSION'] = '5.0'

      # Fix BoringSSL-GRPC 'unsupported option -G' error on Xcode 16+
      if target.name == 'BoringSSL-GRPC'
        # Scrub target-level flags
        ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_name|
          flags = config.build_settings[flag_name] || ['$(inherited)']
          if flags.is_a?(Array)
            flags.delete('-G')
          elsif flags.is_a?(String)
            flags = flags.gsub('-G', ' ')
          end
          config.build_settings[flag_name] = flags
        end

        # Scrub individual file-level flags
        target.source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            current_flags = file.settings['COMPILER_FLAGS']
            scrubbed_flags = current_flags.split(' ').reject { |f| f == '-G' || f == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }.join(' ')
            file.settings['COMPILER_FLAGS'] = scrubbed_flags
          end
        end
      end
    end
  end

  # 2. Apply config to USER project (Runner) targets
  installer.aggregate_targets.each do |aggregate_target|
    # Ensure usage of the user project
    user_project = aggregate_target.user_project
    next if user_project.nil?

    user_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Fix "Include of non-modular header inside framework module" (Xcode 16)
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        
        # Explicitly suppress non-modular include errors
        ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_name|
          flags = config.build_settings[flag_name] || ['$(inherited)']
          new_flag = '-Wno-non-modular-include-in-framework-module'
          if flags.is_a?(Array)
            flags << new_flag unless flags.include?(new_flag)
          elsif flags.is_a?(String)
            flags += " #{new_flag}" unless flags.include?(new_flag)
          end
          config.build_settings[flag_name] = flags
        end

        # Force stable deployment target
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.4'

         # Enforce Swift 5.0
        config.build_settings['SWIFT_VERSION'] = '5.0'

        # Bitcode is deprecated
        config.build_settings['ENABLE_BITCODE'] = 'NO'
      end
    end
  end

  # Fix gRPC-Core 'missing template argument list' error on Xcode 16+
  Dir.glob("Pods/**/basic_seq.h").each do |file|
    text = File.read(file)
    if text.include?("Traits::template CallSeqFactory")
      puts "Patching #{file} to fix gRPC template error..."
      new_contents = text.gsub("Traits::template CallSeqFactory", "Traits::CallSeqFactory")
      File.open(file, "w") { |f| f.write(new_contents) }
    end
  end
end
