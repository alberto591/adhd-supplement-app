# 1. Set the global platform to iOS 15.4 (aligned with Xcode/Swift requirements)
platform :ios, '15.4'

# Optimizations
install! 'cocoapods', :disable_input_output_paths => true
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Run flutter pub get first."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Force stable deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.4'
      
      # Force Swift 5.0 to avoid Swift 6 concurrency/strictness errors in pods
      config.build_settings['SWIFT_VERSION'] = '5.0'
      
      # Fix legacy flag interference (GCC_WARN_INHIBIT_ALL_WARNINGS)
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'NO'
      
      # Enable compatibility for modern architectures
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Fix BoringSSL-GRPC 'unsupported option -G' error on Xcode 16+
      if target.name == 'BoringSSL-GRPC'
        cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
        if cflags.is_a?(Array)
          cflags.delete('-G')
        elsif cflags.is_a?(String)
          cflags = cflags.gsub('-G', ' ')
        end
        config.build_settings['OTHER_CFLAGS'] = cflags
      end
    end
  end
end
