rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profile: read/write by owner
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Top-level user-data collections keyed by userId
    match /streaks/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /gamification/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Top-level collections where userId is a field
    match /state_checkins/{checkinId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    
    match /logs/{logId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // Global Collections: Read for everyone
    match /supplements/{supplementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /compatibilitys/{compatibilityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /community/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Write-only tracking
    match /referral_clicks/{clickId} {
      allow create: if true;
    }
  }
}
